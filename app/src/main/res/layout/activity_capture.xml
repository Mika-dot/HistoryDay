<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_capture_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="116dp"
        android:background="@drawable/bg_capture_frame" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_capture_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/recordingDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_recording_dot"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/capture_ready"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchCameraButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@string/switch_to_back_camera"
            app:backgroundTint="#AA111827"
            app:icon="@drawable/ic_flip_camera"
            app:iconTint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/cameraNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_capture_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="@string/front_camera"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/captureProgress"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="15dp"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/primary"
            app:trackColor="#55FFFFFF"
            app:trackCornerRadius="4dp"
            app:trackThickness="7dp" />
    </LinearLayout>
</FrameLayout>
